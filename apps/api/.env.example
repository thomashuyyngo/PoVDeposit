NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pov_deposit
PUBLIC_ORIGIN=http://localhost:3000

# The network selects the passphrase, Horizon and Soroban RPC together. A
# passphrase or Horizon endpoint belonging to the other network is refused at
# startup, because signing for one chain and submitting to another fails only
# after the user has already approved the transaction.
STELLAR_NETWORK=PUBLIC
STELLAR_RPC_URL=https://stellar.api.onfinality.io/public
STELLAR_HORIZON_URL=https://horizon.stellar.org
ESCROW_CONTRACT_ID=CBTPBD7SACNHMCU7F6EB7UCWUCR5IFA4SP2DCDSRSZO4DCBO3BPO2TJD

# Signs the one-time check-in challenge the host shows at the property. Leave it
# unset only in development: a random key then rotates on every restart and
# every outstanding challenge stops verifying.
CHECKIN_TOKEN_SECRET=
SESSION_SECRET=

# Inlined into the browser bundle at build time, so set this before building.
NEXT_PUBLIC_STELLAR_NETWORK=PUBLIC
