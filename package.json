{
  "name": "pov-deposit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r test && node --test apps/web/*.test.js",
    "test:contracts": "cargo test --manifest-path packages/contracts/Cargo.toml",
    "start": "corepack pnpm --filter @pov-deposit/api start",
    "migrate": "corepack pnpm --filter @pov-deposit/api migrate",
    "seed": "corepack pnpm --filter @pov-deposit/api seed"
  }
}
